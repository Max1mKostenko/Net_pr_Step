<Window x:Class="WpfApp11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp11"
        mc:Ignorable="d"
        Title="Chat Server" Height="450" Width="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="0.15*" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.3*" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<Label x:Name="labelClients" Content="Clients: 0" FontSize="22" FontWeight="Bold"
               VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
               Background="LightGray"/>

		<Label Grid.Column="1" Content="Chat" FontSize="22" FontWeight="Bold"
               VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
               Background="LightGray"/>

		<ListView x:Name="lvClients" Grid.Row="1" Background="LightYellow" Margin="10" FontSize="18"
                  Cursor="Hand"/>

		<ListView x:Name="lvChat" Grid.Row="1" Grid.Column="1" Background="LightGray" Margin="10" FontSize="18" />
	</Grid>
</Window>